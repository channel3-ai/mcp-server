{
	"name": "mcp-server",
	"main": "src/index.ts",
	// Widened past src/ so the bundled UI under public/ is inside the module root.
	"base_dir": "./",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public",
		// Default auto-trailing-slash strips .html; serve assets at literal paths.
		"html_handling": "none"
	},
	"vars": {
		"CHANNEL3_BASE_URL": ""
	},
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		},
		{
			"renamed_classes": [{ "from": "MyMCP", "to": "Channel3MCP" }],
			"tag": "v2"
		},
		{
			"deleted_classes": ["Channel3MCP"],
			"tag": "v3"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	}
}
