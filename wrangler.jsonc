{
	"name": "mcp-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"vars": {
		"CHANNEL3_BASE_URL": "",
		// Hosts exempt from the free-tier limit; see isVerifiedHost.
		"HOST_BYPASS_CIDRS": "160.79.104.0/21",
		"HOST_BYPASS_MTLS_ISSUERS": "OpenAI-Connectors-mTLS-CA"
	},
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1"
		},
		{
			"renamed_classes": [{ "from": "MyMCP", "to": "Channel3MCP" }],
			"tag": "v2"
		},
		{
			"deleted_classes": ["Channel3MCP"],
			"tag": "v3"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},
	"ratelimits": [
		{
			"name": "FREE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	]
}
